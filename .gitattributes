# Normalize line endings to LF for all text files. Critical for the bin/sediment
# shebang and for Linux CI — CRLF in an executable PHP script breaks it.
* text=auto eol=lf

*.php   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.dist  text eol=lf
bin/sediment text eol=lf

# Keep the distributed Composer package lean: dev-only files are not shipped.
/tests               export-ignore
/.github             export-ignore
/.gitattributes      export-ignore
/.gitignore          export-ignore
/phpunit.xml.dist    export-ignore
