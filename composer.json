{
    "name": "sediment/analyzer",
    "description": "A static analyzer that reads a WordPress plugin's source code and reports exactly what it leaves behind in your database.",
    "type": "project",
    "keywords": ["wordpress", "static-analysis", "uninstall", "database", "cleanup", "php-parser", "cli"],
    "homepage": "https://github.com/SNO7E-G/Sediment",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Mahmoud Ashraf",
            "email": "182176867+SNO7E-G@users.noreply.github.com"
        }
    ],
    "support": {
        "issues": "https://github.com/SNO7E-G/Sediment/issues",
        "source": "https://github.com/SNO7E-G/Sediment",
        "docs": "https://github.com/SNO7E-G/Sediment/blob/main/docs/manifest-schema.md"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "nikic/php-parser": "^5.0",
        "symfony/console": "^7.0",
        "symfony/process": "^7.0"
    },
    "require-dev": {
        "opis/json-schema": "^2.4",
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "ext-zip": "Needed by `sediment fetch` to unpack plugins downloaded from wordpress.org",
        "ext-curl": "Used by `sediment fetch`; without it PHP's stream wrappers are used instead"
    },
    "autoload": {
        "psr-4": {
            "Sediment\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sediment\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/sediment"],
    "scripts": {
        "test": "phpunit",
        "sediment": "bin/sediment"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
